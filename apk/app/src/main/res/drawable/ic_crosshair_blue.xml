<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <size android:width="1dp" android:height="6dp" />
            <solid android:color="#2196F3" />
        </shape>
    </item>
    <item android:gravity="center" android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <size android:width="6dp" android:height="1dp" />
            <solid android:color="#2196F3" />
        </shape>
    </item>
</layer-list>
