<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.iceflow.roclicktaq">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.touchsprite.android" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:label="ROClickTAQ"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <service
            android:name=".run.ActionService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".overlay.OverlayService"
            android:exported="false" />
        <service
            android:name=".overlay.AimOverlayService"
            android:exported="false" />
        <service
            android:name=".overlay.AimOverlayServiceBlack"
            android:exported="false" />
        <service
            android:name=".overlay.AimOverlayServiceRed"
            android:exported="false" />
        <service
            android:name=".overlay.AimOverlayServiceBlue"
            android:exported="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LogsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CapturePermissionActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".ui.PermissionStarterActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".run.ForegroundCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
